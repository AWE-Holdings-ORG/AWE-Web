{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "awe-web",
  "main": "worker.js",
  "compatibility_date": "2026-09-27",
  "send_metrics": false,
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "previews": {}
}
