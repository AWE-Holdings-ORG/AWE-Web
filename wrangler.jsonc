{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "awe-web",
  "main": "worker-entry.js",
  "compatibility_date": "2026-09-27",
  "send_metrics": false,
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/api/*",
      "/crown/*"
    ]
  },
  "previews": {
    "d1_databases": [
      {
        "binding": "CROWN_DB",
        "database_name": "awe-crown-identity-preview",
        "database_id": "d93128c2-d34d-4372-be01-72ae772a9230"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "CROWN_DB",
      "database_name": "awe-crown-identity-preview",
      "database_id": "d93128c2-d34d-4372-be01-72ae772a9230",
      "migrations_dir": "migrations"
    }
  ]
}
